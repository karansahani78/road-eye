# RoadEye Environment Configuration
# Copy this file to .env and adjust values for your environment

# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/roadeye
SPRING_DATASOURCE_USERNAME=roadeye
SPRING_DATASOURCE_PASSWORD=roadeye_dev

# Kafka
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=roadeye
MINIO_SECRET_KEY=roadeye_dev
MINIO_BUCKET=roadeye-evidence

# JWT
JWT_SECRET=change-this-to-a-secure-random-secret-in-production
JWT_EXPIRATION=86400000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AI Engine
AI_SERVICE_URL=http://localhost:8000

# Encryption
APP_ENCRYPTION_KEY=change-me-to-a-32-byte-key-in-production

# Geocoding
GEOCODING_PROVIDER=nominatim
NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=RoadEye/1.0
